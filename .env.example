# Base image: vLLM v0.27.0 on NGC 26.07, native DeepSeek V4, SM121.
BASE_IMAGE=ghcr.io/bjk110/vllm-spark:v027-ngc2607-dsv4-0731-dspark-k7-256k-production
DSPARK_VLLM_IMAGE=vllm-dspark-steering:v027

VLLM_PORT=8888
SERVED_MODEL_NAME=deepseek-v4-flash-dspark
KV_CACHE_DTYPE=nvfp4_ds_mla
MAX_MODEL_LEN=1048576
GPU_MEMORY_UTILIZATION=0.80

# Steering is off unless DSPARK_STEER_PATH is set. Confirm the boot log reports
# layers=29, not layers=1.
DSPARK_STEER_PATH=
DSPARK_STEER_ALPHA=4.0
DSPARK_STEER_LAYERS=
