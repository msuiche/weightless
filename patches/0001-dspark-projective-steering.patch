+# offline tooling; NOT read by the forward path. The pre-fold writer-isolation
+# hooks that used it are deliberately not ported: they branch on
+# _DSPARK_STEER_HOOK inside the traced region, and that choice is not part of
+# vLLM's compile cache key, so a cached artifact would silently ignore a changed
+# hook site. Reintroduce them behind a separate image if that experiment is
+# re-run, and clear the compile cache when doing so.
+_DSPARK_HOOK_DIRS: dict[int, torch.Tensor] = {}
