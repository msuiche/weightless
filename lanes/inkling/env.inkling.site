# site values — live-lane ground truth 2026-09-02
# .env.inkling is gitignored; never commit the real file.
# Inkling-Small NVFP4, TP=2 across 2x DGX Spark, stock vLLM v0.28.0,
# GLP-41 steering at alpha=0.25 (calibrated — do NOT raise; alpha>=0.5 garbles).

# Cluster
MASTER_ADDR=192.168.100.1
MASTER_PORT=25020
WORKER_HOST=192.168.100.2
VLLM_HOST_IP=192.168.100.1
WORKER_VLLM_HOST_IP=192.168.100.2

# RoCE — single HCA exact match (the dual-rail pin + EP combo cost us a
# rig-day on the qwen38fn lane; NCCL_IB_AUTO_DETECT=0 is set in the script)
NCCL_IB_HCA==rocep1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_INDEX=3

# Caches / model
HF_CACHE=/home/msuiche/.cache/huggingface

# Stock vLLM release image — inkling is day-0 since v0.28.0.
INKLING_IMAGE=vllm/vllm-openai:v0.28.0
MODEL=thinkingmachines/Inkling-Small-NVFP4
SERVED_MODEL_NAME=inkling-small-nvfp4
VLLM_PORT=8082

# Serving profile. NVFP4 is 159 GiB -> ~85 GiB/rank at TP=2; util 0.835 is the
# measured GB10 sweet spot (same as qwen38fn). Preflight fails closed over
# leftover GPU processes and insufficient free memory.
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.835
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192

# Steering (GLP-41). The steered model.py is a PRE-PATCHED copy of the image's
# vllm/models/inkling/nvidia/model.py (hotfix applied offline once), staged at
# files/inkling-model-steered.py on BOTH nodes. The GGUF lives at the root of
# the HF cache on both nodes.
WEIGHTLESS_STEER_PATH=/home/msuiche/.cache/huggingface/Inkling-Small-abliterated-cyber-GLP-41-L1-41-a0.25.gguf
WEIGHTLESS_STEER_ALPHA=0.25
STEERED_MODEL_PY=files/inkling-model-steered.py
