# Copy to .env.museglimmer on a free DGX Spark.
# Muse-Glimmer-30B NVFP4 (ModelOpt mixed W4A16-NVFP4/FP8/BF16, 24.7 GB) —
# dense 52-layer transformer + ~1.8B perception encoder, 131K context.
# vLLM 0.28.0 serves the muse_glimmer arch, its ATEM tool parser, its
# reasoning parser, and the DFlash block-diffusion drafter natively.
MUSE_IMAGE=vllm/vllm-openai:v0.28.0
MODEL_ID=nvidia/Muse-Glimmer-30B-NVFP4
MODEL_REVISION=f45fad5689e9a4d937f7e872fbec20c4e8a74154
HF_CACHE=/home/<user>/.cache/huggingface
CONTAINER_NAME=museglimmer
VLLM_PORT=8084
SERVED_MODEL_NAME=muse-glimmer-nvfp4
# Card-tested window; the checkpoint's max_position_embeddings is 131072.
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.92
# Agentic default; the card's 64 is a throughput setting for B200 serving.
MAX_NUM_SEQS=8
# DFlash block-diffusion drafter (5 layers, block size 16, predicts from
# hidden layers {1,13,25,37,49}). vLLM auto-detects method dflash from the
# drafter's MuseGlimmerAssistantModel architecture. none = target only.
SPECULATIVE_MODE=dflash
DRAFTER_MODEL_ID=meta-models/Muse-Glimmer-30B-assistant
DRAFTER_REVISION=e8192f3a8f617f74be2ce220360c89ef4789f39f
# One drafter forward proposes a full 16-token block.
NUM_SPECULATIVE_TOKENS=16
# No GLP steering vector exists for muse_glimmer yet — the wizard does not
# offer steering on this lane. When one is derived it goes here (and the
# boot must refuse SPECULATIVE_MODE=dflash until the drafter is steered).
WEIGHTLESS_GLP=
