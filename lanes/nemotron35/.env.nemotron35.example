# Copy to .env.nemotron35 on an available DGX Spark.
# GLP-51 is the shipped steering vector for this lane (validated:
# refusal32 0->32/32, benign32 32/32 unchanged, termination intact).
NEMOTRON_IMAGE=vllm/vllm-openai:v0.28.0
MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
MODEL_REVISION=cc84af2fe71647d87f4486c064f320e1e7535243
HF_CACHE=/home/<user>/.cache/huggingface
CONTAINER_NAME=nemotron35
VLLM_PORT=8083
SERVED_MODEL_NAME=nemotron35-lightning-nvfp4
# Conservative initial boot. NVIDIA documents up to 1M; test before raising.
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.85
MAX_NUM_SEQS=4
# NVIDIA recommends this draft for interactive Spark workloads, but the
# MTP nextn layer is not steered: GLP requires SPECULATIVE_MODE=none
# (the launcher refuses otherwise). For stock + spec decode, comment out
# WEIGHTLESS_GLP below and set this back to dspark.
SPECULATIVE_MODE=none
DRAFT_MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark
NUM_SPECULATIVE_TOKENS=3
# GLP steering (fail-closed boot hotfix, post-layer residual stream).
# Host path to the glp.* GGUF control vector; empty = stock. Requires
# SPECULATIVE_MODE=none (see above).
# Validated vector: msuiche/Nemotron-3.5-Lightning-30B-A3B-abliterated-cyber-GLP-51-L1-51-a1.0
WEIGHTLESS_GLP=/home/<user>/.cache/huggingface/Nemotron-3.5-Lightning-30B-A3B-abliterated-GLP-51-L1-51-a1.0.gguf
WEIGHTLESS_GLP_ALPHA=1.0
# NVIDIA's model card pins vllm/vllm-openai:v0.27.1; on GB10 the locally
# pulled multi-arch v0.28.0 is the default (hotfix anchors verified against
# both).
