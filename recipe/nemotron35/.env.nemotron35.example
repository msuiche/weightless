# Copy to .env.nemotron35 on an available DGX Spark.
# This is a stock-model lane; no GLP artifact is supplied.
NEMOTRON_IMAGE=vllm/vllm-openai:v0.27.1
MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
MODEL_REVISION=cc84af2fe71647d87f4486c064f320e1e7535243
HF_CACHE="${HOME}/.cache/huggingface"
CONTAINER_NAME=nemotron35
VLLM_PORT=8083
SERVED_MODEL_NAME=nemotron35-lightning-nvfp4
# Conservative initial boot. NVIDIA documents up to 1M; test before raising.
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.85
MAX_NUM_SEQS=4
# NVIDIA recommends this draft for interactive Spark workloads.
# Set SPECULATIVE_MODE=none for the stock target-only baseline.
SPECULATIVE_MODE=dspark
DRAFT_MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark
NUM_SPECULATIVE_TOKENS=3
# Optional GLP steering (fail-closed boot hotfix, post-layer residual
# stream). Host path to the glp.* GGUF control vector; unset = stock.
# Requires SPECULATIVE_MODE=none (the MTP nextn layer is not steered).
# Validated vector: msuiche/Nemotron-3.5-Lightning-30B-A3B-abliterated-cyber-GLP-51-L1-51-a1.0
#WEIGHTLESS_GLP=/models/vectors/nemotron35-glp51.gguf
#WEIGHTLESS_GLP_ALPHA=1.0
# On GB10 use the locally pulled multi-arch v0.28.0 (v0.27.1 arm64 exists
# upstream but is not pulled; hotfix anchors verified against both):
#NEMOTRON_IMAGE=vllm/vllm-openai:v0.28.0
