# EXAMPLE — copy to .env.qwen38fn and fill in <...> placeholders.
# .env.qwen38fn is gitignored; never commit the real file.
# Qwen3.8-Flash-Next NVFP4, TP=2 across 2x DGX Spark (head + worker over
# RoCE), day-0 image vllm/vllm-openai:qwen38-flash-next, GLP-47 steering.

# Cluster
MASTER_ADDR=<head-ip>
MASTER_PORT=25010
WORKER_HOST=<worker-ip>
WORKER_DIR=/home/<user>/dspark-qwen38fn
# Per-node fabric IPs for VLLM_HOST_IP (default: MASTER_ADDR / WORKER_HOST).
VLLM_HOST_IP=<head-ip>
WORKER_VLLM_HOST_IP=<worker-ip>

# RoCE / InfiniBand — same dual-rail fabric as the DSV4 lane: rocep1s0f0 =
# 192.0.2.0/24, roceP2p1s0f0 = 198.51.100.0/24 (documentation subnets —
# substitute yours). GID index 3 is the IPv4-mapped RoCEv2 GID on BOTH HCAs
# on BOTH nodes (re-verify after reboot — indexes drift; this lane has no
# sysfs auto-resolver, the pin is what you get).
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN

# Caches / model — the GGUF vector also lives at the ROOT of this cache (it is
# mounted at /cache/huggingface in the container, both nodes).
HF_CACHE=/home/<user>/.cache/huggingface
WORKER_HF_CACHE=/home/<user>/.cache/huggingface
HF_HUB_OFFLINE=1

# Day-0 serving image (arm64 exists). Model: ~135 GB NVFP4.
QWEN38FN_IMAGE=vllm/vllm-openai:qwen38-flash-next
MODEL=RadixArk/Qwen3.8-Flash-Next-NVFP4
SERVED_MODEL_NAME=qwen38-flash-next-nvfp4
VLLM_PORT=8079

# Serving profile.
# VLLM_PLE_CPU_OFFLOAD=1 would keep the 51B N-gram table in host RAM, but the
# arm64 day-0 image rejects it at nnodes=2 (verified 2026-09-01 -- the x86
# build allows it; do not copy that config here). With PLE in HBM (~25.5
# GB/rank), the safe envelope is util 0.88 + 64K ctx, or util 0.80 for 262K.
# GMU 0.835 is the measured sweet spot (MiaAI-Lab's running 2-Spark
# deployment, 2026-09-01): 101.6 GiB budgeted, 35 GiB KV pool (2.48M tokens).
# The start script also drops page caches on both nodes before launch —
# mandatory on GB10 unified memory, since the model rsync stuffs ~135 GB of
# page cache right before boot.
# The start script fails closed on both misconfigurations and on leftover GPU
# processes (a crash-loop's CUDA memory survives docker rm -f and the next
# load stacks on top -- that wedged both nodes on unified memory 2026-09-01).
# Prefix caching MUST stay off: with this arch it forces
# mamba_cache_mode="align", which splits every prefill at a block boundary and
# corrupts capture/steering (capture-lane run 3). The start script always
# passes --no-enable-prefix-caching.
VLLM_PLE_CPU_OFFLOAD=0
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.835

# Projective activation steering (GLP-47) — applied on BOTH nodes by
# patches/hotfix-qwen38fn-steering-projective.py (container entrypoint,
# fail-closed when this is set but the patch/vector can't apply). Vector is
# read inside the container from /cache/huggingface (=$HF_CACHE). Published
# artifact: hf.co/msuiche/Qwen3.8-Flash-Next-abliterated-cyber-GLP-47 (gated).
# Alpha is calibrated AT 1.0 — do NOT import the DSV4 lane's 4.0; higher
# alpha over-projects. Empty LAYERS = every layer in the file (1-47).
WEIGHTLESS_STEER_PATH=/cache/huggingface/Qwen3.8-Flash-Next-abliterated-cyber-GLP-47-L1-47-a1.gguf
WEIGHTLESS_STEER_ALPHA=1.0
WEIGHTLESS_STEER_LAYERS=

# Only set if the image's model.py is NOT at the dist-packages default —
# discover it rather than assuming (see README):
#   docker run --rm --entrypoint /usr/bin/python3.12 "$QWEN38FN_IMAGE" -c \
#     'import importlib.util; print(importlib.util.find_spec("vllm.models.qwen3_8_flash_next.nvidia.model").origin)'
WEIGHTLESS_STEERING_MODEL_PY=
