# EXAMPLE — copy to .env.glm53tp2 and fill in <...> placeholders.
# GLM-5.3-Flash NVFP4 (compressed-tensors W4A4), TP=2 on 2x DGX Spark.
# Structure-validated bring-up profile; not yet booted on our rig.

# Cluster — launch this script on the head; it stages and starts the worker.
MASTER_ADDR=<head-ip>
MASTER_PORT=29521
WORKER_HOST=<worker-ip>
WORKER_DIR=/home/<user>/dspark-glm53tp2
VLLM_HOST_IP=<head-ip>
WORKER_VLLM_HOST_IP=<worker-ip>

# RoCE — single HCA, matching the reference TP2 fabric. Verify with
# ibdev2netdev / ip -br a; GID index 3 must be IPv4-mapped RoCEv2 on both.
NCCL_IB_HCA=rocep1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_INDEX=3

# Local NVMe HF hub cache on EACH node, with models--RedHatAI--... at its
# root. The script explicitly sets HF_HUB_CACHE to this mount. Put the
# optional GGUF at this same root on both nodes.
HF_CACHE=/home/<user>/.cache/huggingface
WORKER_HF_CACHE=/home/<user>/.cache/huggingface

# Actual pin from upstream launch-glm53-vllm-tp2.sh. Stock fails on GB10;
# v9/InstantTensor is unstable multi-node. Both image IDs must match.
GLM53_IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v8
MODEL=RedHatAI/GLM-5.3-Flash-NVFP4
SERVED_MODEL_NAME=glm53-flash
VLLM_PORT=8081  # 8080 collides with signal-cli daemon on rigs that run it

# Default agentic profile: 128K, fp8 KV, CUDA graphs, no speculative head.
# ~97 GiB weights/rank leaves little KV headroom (~4.5–5.5 GiB, varies by
# rank/profile). Let the profiler subtract activation peaks: NEVER copy
# the TP4 KV pin here. 0.78–0.80 starved KV in the reference; retain 0.85.
# Raise MAX_MODEL_LEN to 262144 only after long-prefill/concurrency tests.
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.85
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=4096  # 2048 starves prefill (~470 tok/s); 8192 leaves only 1.19 GiB KV (<1.93 needed for 131K) — 4096 is the measured ceiling

# Optional GLP-44 steering, identical container path/alpha to the TP4 lane.
# Empty PATH disables it. Both ranks run the existing hotfix BEFORE serve;
# missing/nonunique anchors or invalid vectors fail closed.
# Alpha 2.0 is calibrated; >=2.5 garbles this model. Empty LAYERS = 1–44.
WEIGHTLESS_STEER_PATH=/cache/huggingface/GLM-5.3-Flash-abliterated-cyber-GLP-44-L1-44-a2.gguf
WEIGHTLESS_STEER_ALPHA=2.0
WEIGHTLESS_STEER_LAYERS=

# Optional DFlash2 speculative decoding (~2.15x decode in the reference).
# Requires the sm121-v11-dflash2 image on BOTH nodes and the drafter
# (incoai/GLM-5.3-Flash-DFlash2, ~2.2 GB) in the same HF cache on both.
# The drafter slot-shares the MLA KV tensors but still trades KV pool for
# speed (~-40% pool for +91% decode at 262K in the reference). Runs
# enforce-eager: CUDA graphs with the drafter are unqualified on GB10.
# SPECULATIVE=dflash2
# GLM53_IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2
# DRAFTER_MODEL=incoai/GLM-5.3-Flash-DFlash2
