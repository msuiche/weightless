# EXAMPLE — copy to .env.glm53xl and fill in <...> placeholders.
# .env.glm53xl is gitignored; never commit the real file.
# GLM-5.3 743B flagship (glm_moe_dsa), TP=4 across 4x DGX Spark (head + 3
# workers over RoCE), tonyd2wild's Int4-Int8Mix stack, GLP-77 steering.
# THIS LANE NEEDS 4 NODES.

# Cluster
MASTER_ADDR=<head-ip>
MASTER_PORT=25030
WORKER_HOST=<worker-ip>
WORKER2_HOST=<worker2-ip>
WORKER3_HOST=<worker3-ip>
WORKER_DIR=/home/<user>/dspark-glm53xl
# Per-node fabric IP for VLLM_HOST_IP on the head (default: MASTER_ADDR);
# workers default to their own WORKER*_HOST.
VLLM_HOST_IP=<head-ip>

# RoCE / InfiniBand — same dual-rail fabric as the other lanes: rocep1s0f0 =
# 192.0.2.0/24, roceP2p1s0f0 = 198.51.100.0/24 (documentation subnets —
# substitute yours). GID index 3 is the IPv4-mapped RoCEv2 GID on BOTH HCAs
# on ALL nodes (re-verify after reboot — indexes drift).
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN

# The stack (tonyd2wild, hardware-validated 2026-08-29 — see README.md):
# - image: vllm-node-tf5-glm52-b12x:probe-modded — a LOCAL build (per the
#   GLM-5.2 QuantTrio repo), must exist on ALL 4 nodes with the same ID;
#   the start script checks.
# - kernels: the 10-file sm12x overlay dir (incl. the deepseek_v2.py that
#   defines GlmMoeDsaForCausalLM) — staged per node, preflighted.
# - weights: 2wild4tv/GLM-5.3-Int4-Int8Mix (377.4 GiB) — local on the head,
#   NFS-shared to the workers (nodes 3/4 can't hold a 378 GB local copy).
GLM53XL_IMAGE=vllm-node-tf5-glm52-b12x:probe-modded
KERNELS_DIR=/home/<user>/glm-triton
WEIGHTS_HEAD=/var/tmp/models/GLM-5.3-Int4-Int8Mix
WEIGHTS_WORKERS=/mnt/reddie-models/GLM-5.3-Int4-Int8Mix

# HF cache — the GGUF vector lives at its ROOT (mounted at /cache/huggingface
# in the container, all four nodes; the NCCL 2.30.4 LD_PRELOAD lib also lives
# under it in tonyd2wild's layout).
HF_CACHE=/home/<user>/.cache/huggingface
WORKER_HF_CACHE=/home/<user>/.cache/huggingface
HF_HUB_OFFLINE=1

SERVED_MODEL_NAME=glm-5.3
VLLM_PORT=8081

# Serving profile — the validated TP4 config: fp8_ds_mla KV, gmu 0.91 with
# the KV budget PINNED (page-cache state must not change what a boot gets),
# 200K context, MTP k=4, CUDA graphs FULL. Bare mode (SPEC_MODE=none) is the
# quant-coherence check lane, not the serving lane.
SPEC_MODE=mtp
MTP_NUM_TOKENS=4
MAX_MODEL_LEN=200000
MAX_NUM_SEQS=6
GPU_MEMORY_UTILIZATION=0.91
KV_CACHE_MEMORY_BYTES=10950000000

# Projective activation steering (GLP-77) — staged per node at START time
# (the overlay deepseek_v2.py is bind-mounted read-only in the container, so
# the start script patches a copy and mounts the patched copy; the anchor
# check fails closed before any GPU time is spent). Published artifact:
# hf.co/msuiche/GLM-5.3-abliterated-GLP-77 (gated).
#
# Alpha is calibrated AT 1.0 — and on this model higher alpha makes refusal
# WORSE at full length (measured). Do not raise it. Empty LAYERS = every
# layer in the file (1-77).
WEIGHTLESS_STEER_PATH=/cache/huggingface/GLM-5.3-abliterated-GLP-77-L1-77-a1.0.gguf
WEIGHTLESS_STEER_ALPHA=1.0
WEIGHTLESS_STEER_LAYERS=
