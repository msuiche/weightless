# EXAMPLE — copy to .env.glm53 and fill in <...> placeholders.
# .env.glm53 is gitignored; never commit the real file.
# GLM-5.3-Flash NVFP4, TP=4 across 4x DGX Spark (head + 3 workers over RoCE),
# GLP-44 steering. THIS LANE NEEDS 4 NODES (a 2-node 262K TP2 option exists —
# see README — but stays out of scope for this lane).
#
# The stock day-0 image dies five different ways on GB10 (see README.md): the
# working image is the sm121-v8 patch stack, and the start script REFUSES any
# image tag without "sm121" in it.

# Cluster
MASTER_ADDR=<head-ip>
MASTER_PORT=25020
WORKER_HOST=<worker-ip>
WORKER2_HOST=<worker2-ip>
WORKER3_HOST=<worker3-ip>
WORKER_DIR=/home/<user>/dspark-glm53
# Per-node fabric IP for VLLM_HOST_IP on the head (default: MASTER_ADDR);
# workers default to their own WORKER*_HOST.
VLLM_HOST_IP=<head-ip>

# RoCE / InfiniBand — same dual-rail fabric as the other lanes: rocep1s0f0 =
# 192.0.2.0/24, roceP2p1s0f0 = 198.51.100.0/24 (documentation subnets —
# substitute yours). GID index 3 is the IPv4-mapped RoCEv2 GID on BOTH HCAs
# on ALL nodes (re-verify after reboot — indexes drift; this lane has no
# sysfs auto-resolver, the pin is what you get).
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN

# Caches — the HF cache holds the model snapshot (HF_HUB_OFFLINE=1) AND the
# GGUF vector at its root (mounted at /cache/huggingface in the container,
# all four nodes).
HF_CACHE=/home/<user>/.cache/huggingface
WORKER_HF_CACHE=/home/<user>/.cache/huggingface
HF_HUB_OFFLINE=1

# Image: the sm121-v8 patch stack on day-0 vllm/vllm-openai:glm53-flash-arm64-cu130
# (vLLM 0.1.dev20051). Prebuilt: radixark/vllm-glm53-flash:sm121-v8 (what the
# tonyd2wild TP4 launcher ships). Local-build alternative: their
# docker/Dockerfile.glm53-sm121* v1->v8 in order, each FROM the previous.
# v9/InstantTensor is UNSTABLE multi-node — do not use.
GLM53_IMAGE=radixark/vllm-glm53-flash:sm121-v8

# Model: the LibertAIDAI NVFP4 quant — ~50 GiB/rank at TP4, which is what
# dissolves the GB10 KV-allocation ceiling (vs the 306 GB FP8 original).
MODEL=LibertAIDAI/GLM-5.3-Flash-NVFP4
SERVED_MODEL_NAME=glm53-flash
VLLM_PORT=8080

# Serving profile — the hardware-validated TP4 flagship config (tonyd2wild,
# 2026-08-27): 1M context (24 GiB KV/rank = 3.77M fp8 tokens = 3.6 full-1M
# requests), block 2304 (DeepGEMM fp8 paged-MQA 64-entry pool pages + MLA 128
# alignment), MTP k=4 (their acceptance data suggests 3 as a micro-tune),
# fp8 KV, gmu 0.85 with the KV budget PINNED — the MTP draft head OOMs riding
# the gmu edge. 25769803776 = 24 GiB/rank, stress-gated behind 3x concurrent
# 20K prefills; if you change gmu/model, take vLLM's startup-log suggestion
# instead of keeping this number.
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
BLOCK_SIZE=2304
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_MEMORY=25769803776
MTP_NUM_TOKENS=4

# Projective activation steering (GLP-44) — applied on ALL FOUR nodes by
# patches/hotfix-glm53-steering-projective.py (container entrypoint,
# fail-closed when this is set but the patch/vector can't apply). Vector is
# read inside the container from /cache/huggingface (=$HF_CACHE). Published
# artifact: hf.co/msuiche/GLM-5.3-Flash-abliterated-GLP-44 (gated).
#
# Alpha is calibrated AT 2.0 — and WARNING: alpha >= 2.5 GARBLES this model
# (measured; the cliff is abrupt). Do not raise it; do not import another
# lane's alpha. Empty LAYERS = every layer in the file (1-44).
WEIGHTLESS_STEER_PATH=/cache/huggingface/GLM-5.3-Flash-abliterated-GLP-44-L1-44-a2.gguf
WEIGHTLESS_STEER_ALPHA=2.0
WEIGHTLESS_STEER_LAYERS=

# Only set if the image's model.py is NOT at the dist-packages default —
# discover it rather than assuming (see README):
#   docker run --rm --entrypoint /usr/bin/python3.12 "$GLM53_IMAGE" -c \
#     'import importlib.util; print(importlib.util.find_spec("vllm.models.glm5next.nvidia.model").origin)'
WEIGHTLESS_STEERING_MODEL_PY=
