# EXAMPLE — copy to .env.qwen and fill in <...> placeholders.
# .env.qwen is gitignored; never commit the real file.
# Qwen TP=1 lane: Qwen3.8-27B-NVFP4 on a single DGX Spark, MTP-3,
# projective steering optional (off when QWEN_STEER_PATH is empty).

# Host dir containing Qwen3.8-27B-NVFP4/ (and cvec/ for the vector).
MODELS=/home/<user>/models-local-qwen38

# Pinned GB10 build — stock vLLM has no sm_121a NVFP4 kernels.
# Mirror of eugr/spark-vllm-b12x:nightly-20260813 (fallback if unreachable).
QWEN_IMAGE=ghcr.io/drowzeys/keys-vllm-027-gb10-qwen38:mtp3-20260813

VLLM_PORT=8078
SERVED_MODEL_NAME=qwen38-nvfp4
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.90
MTP_NUM_TOKENS=3

# Steering mode: gguf (hotfix-patched vLLM, fail-closed) or lora (stock vLLM
# --enable-lora, no patch; served as the qwen-abliterated module).
STEER_MODE=gguf

# LoRA mode only: peft layout dir (adapter_config.json +
# adapter_model.safetensors) — see README for packaging.
QWEN_LORA_DIR=/models/lora/qwen-abliterated

# GGUF mode only. Container path — /models is the MODELS mount, so put the
# GGUF in $MODELS/cvec/. Canonical vector (evals' shipping artifact, alpha
# calibrated at 1.0 — do NOT import the DSV4 lane's 4.0):
QWEN_STEER_PATH=/models/cvec/Qwen3.8-27B-refusal-cvec-per_layer-L10-58-a1.gguf
QWEN_STEER_ALPHA=1.0
QWEN_STEER_LAYERS=

# Only set if the image's qwen3_next.py is NOT at the dist-packages default —
# discover it rather than assuming (see README; the DSV4 lane got bitten by a
# source-install path once):
#   docker run --rm --entrypoint python3 "$QWEN_IMAGE" -c \
#     'import importlib.util; print(importlib.util.find_spec("vllm.model_executor.models.qwen3_next").origin)'
QWEN_STEERING_MODEL_PY=
