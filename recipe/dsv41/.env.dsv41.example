# EXAMPLE — copy to .env.dsv41 and fill in <...> placeholders.
# .env.dsv41 is gitignored; never commit the real file.
#
# ###########################################################
# # NOT DEPLOYABLE (2026-09-10). Two hard blockers:
# #   1. vLLM support is vllm-project/vllm PR #56201 (dsv41-feat),
# #      unmerged — no release/day-0 image can load deepseek_v41.
# #   2. The 510 GB FP8+MXFP4 checkpoint fits nothing on the rig
# #      (2x DGX Spark = 256 GB); no 2x128GB-fitting quant exists.
# # Do NOT point this at the rig. Daily driver stays DSV4-0731.
# # See recipe/dsv41/README.md.
# ###########################################################
#
# DeepSeek V4.1 Flash profile for 2x DGX Spark TP=2 — FUTURE, modeled on
# .env.dsv4.example. Values below are the DSV4 lane's with the model
# swapped; NONE of it is validated for deepseek_v41.

# Cluster
WORKER_HOST=<worker-ip>
WORKER_DIR=/home/<user>/dspark-dsv41
WORKER_SCRIPT_DIR=
MASTER_ADDR=<head-ip>
MASTER_PORT=25000
NODE_RANK=0
HEADLESS=

# RoCE / InfiniBand (same dual-rail layout as the DSV4 lane; re-verify GID
# indexes on the rig — they drift across reboots)
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0
TP_SOCKET_IFNAME=enp1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0
NCCL_IB_GID_AUTO=0
NCCL_IB_GID_INDEX=3
WORKER_NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1

# Caches / model
HF_CACHE=/home/<user>/.cache/huggingface
WORKER_HF_CACHE=/home/<user>/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
ABLITERATED=0
# Stock checkpoint pin (MIT, 48 shards, 510.3 GB). A rig deploy needs a
# 2x128GB-fitting quant instead — none exists; do not download this to a
# 128 GB Spark.
DSPARK_REVISION=fb2764a5cf321eaa5070ca8f9e892818f477c16d
DSPARK_ENCODING_FILE=
SERVED_MODEL_NAME=deepseek-v41-flash-dspark
VLLM_HOST=0.0.0.0
VLLM_PORT=8889
VLLM_HOST_IP=<head-ip>
WORKER_VLLM_HOST_IP=<worker-fabric-ip>

# No deployable image exists. The research boot was a source build of
# vllm-project/vllm @ dsv41-feat (PR #56201); see the experiment's
# staging/dsv41_app.py::build_wheel.
DSPARK_VLLM_IMAGE=BLOCKED-no-image-see-recipe-dsv41-README

# Serving profile (unvalidated placeholders — max_model_len comes from the
# checkpoint's 1M rope config; the rig cannot hold the KV even if a quant
# appears, revisit then)
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80

# Projective activation steering. hook_point for the GLP-39 vector is
# residual_stream_post_layer (hc fold, single stream, pre-engram) — NOT the
# DSV4 lane's ffn_out_pre_residual. A conforming loader refuses the
# mismatch; do not reuse hotfix-dsv4-steering-projective.py here, the port
# for deepseek_v4_1 lives in the experiment (staging/patch_dsv41.py).
WEIGHTLESS_STEER_PATH=
WEIGHTLESS_STEER_ALPHA=
WEIGHTLESS_STEER_LAYERS=
WEIGHTLESS_STEER_HOOK=residual_stream_post_layer
